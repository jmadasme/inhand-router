[103.179, "o", "\u001b[90m┌─ docs/datasheet.md · límites ─────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[103.179, "o", "\u001b[90m  83\u001b[0m\u001b[90m │ \u001b[0m\u001b[01m\u001b[95m## 8. Alcance y límites\u001b[39;49;00m\n"]
[103.234, "o", "\u001b[90m  84\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[103.289, "o", "\u001b[90m  85\u001b[0m\u001b[90m │ \u001b[0m**Verificado:** cambio de LAN, pool DHCP, ausencia de SSH en esa imagen y reversión.\u001b[90m\u001b[39;49;00m\n"]
[103.344, "o", "\u001b[90m  86\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[103.399, "o", "\u001b[90m  87\u001b[0m\u001b[90m │ \u001b[0m**No verificado:** otros modelos InHand, otras versiones de firmware, actualizaciones\u001b[90m\u001b[39;49;00m\n"]
[103.454, "o", "\u001b[90m  88\u001b[0m\u001b[90m │ \u001b[0my comportamiento bajo carga. No hay código ni binarios en esta familia.\u001b[90m\u001b[39;49;00m\n"]

[23.827, "o", "\u001b[90m┌─ docs/developer.md · inventario ──────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[23.827, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[01m\u001b[95m## 1. Qué hay en este repositorio\u001b[39;49;00m\n"]
[23.882, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[23.937, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0mUna sola versión, \u001b[33m`versions/inhand-router/`\u001b[39;49;00m, con un único documento de campo:\u001b[90m\u001b[39;49;00m\n"]
[23.992, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[33m`CAMBIOS_Y_REVERSION.md`\u001b[39;49;00m. No hay código ejecutable, firmware ni scripts. La familia\u001b[90m\u001b[39;49;00m\n"]
[24.047, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0mexiste para preservar el registro de una intervención real y evitar que se repita a\u001b[90m\u001b[39;49;00m\n"]
[24.102, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0mciegas.\u001b[90m\u001b[39;49;00m\n"]

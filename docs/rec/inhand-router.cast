[76.83, "o", "\u001b[90m┌─ docs/developer.md · contrato de versión ─────────────────────────────────────────────────────────────\u001b[0m\n"]
[76.83, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0m\u001b[01m\u001b[95m## 5. Contrato de una versión\u001b[39;49;00m\n"]
[76.885, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[76.94, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0mCada carpeta de \u001b[33m`versions/`\u001b[39;49;00m debe poder respondernos:\u001b[90m\u001b[39;49;00m\n"]
[76.995, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[77.05, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00m¿Qué equipo exacto se tocó?\u001b[90m\u001b[39;49;00m\n"]
[77.105, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00m¿Cuál era el estado antes?\u001b[90m\u001b[39;49;00m\n"]
[77.16, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00m¿Qué se cambió y por qué?\u001b[90m\u001b[39;49;00m\n"]
[77.215, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00m¿Qué se verificó?\u001b[90m\u001b[39;49;00m\n"]
[77.27, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00m¿Cómo se vuelve atrás?\u001b[90m\u001b[39;49;00m\n"]
[77.325, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00m¿Qué no se pudo hacer?\u001b[90m\u001b[39;49;00m\n"]
[77.38, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[77.435, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0mSi falta una de esas respuestas, la versión está incompleta aunque el cambio haya\u001b[90m\u001b[39;49;00m\n"]
[77.49, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0mfuncionado.\u001b[90m\u001b[39;49;00m\n"]

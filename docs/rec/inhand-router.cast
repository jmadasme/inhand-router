[115.038, "o", "\u001b[90m┌─ docs/datasheet.md · operación ───────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[115.038, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m\u001b[01m\u001b[95m## 5. Operación\u001b[39;49;00m\n"]
[115.093, "o", "\u001b[90m  51\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[115.148, "o", "\u001b[90m  52\u001b[0m\u001b[90m │ \u001b[0mEl router no queda publicando ningún servicio nuevo. La administración se hace por\u001b[90m\u001b[39;49;00m\n"]
[115.203, "o", "\u001b[90m  53\u001b[0m\u001b[90m │ \u001b[0mel panel web en la LAN. Si se necesita acceso remoto, la recomendación es una VPN o\u001b[90m\u001b[39;49;00m\n"]
[115.258, "o", "\u001b[90m  54\u001b[0m\u001b[90m │ \u001b[0mun overlay de red, no exponer el panel a Internet.\u001b[90m\u001b[39;49;00m\n"]
[115.313, "o", "\u001b[90m  55\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[115.368, "o", "\u001b[90m  56\u001b[0m\u001b[90m │ \u001b[0mPara revisar el detalle de cada paso, el documento fuente es\u001b[90m\u001b[39;49;00m\n"]
[115.423, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m\u001b[33m`versions/inhand-router/CAMBIOS_Y_REVERSION.md`\u001b[39;49;00m. Ese archivo contiene la secuencia\u001b[90m\u001b[39;49;00m\n"]
[115.478, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0mreal y las observaciones de campo.\u001b[90m\u001b[39;49;00m\n"]

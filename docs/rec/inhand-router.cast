[90.708, "o", "\u001b[90m┌─ docs/datasheet.md · seguridad ───────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[90.708, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m\u001b[01m\u001b[95m## 7. Seguridad\u001b[39;49;00m\n"]
[90.763, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[90.818, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mCambiar la contraseña por defecto antes de conectar el equipo a una red compartida.\u001b[90m\u001b[39;49;00m\n"]
[90.873, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mNo reutilizar la clave de administración en otros servicios.\u001b[90m\u001b[39;49;00m\n"]
[90.928, "o", "\u001b[90m  79\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mNo publicar el panel en la WAN.\u001b[90m\u001b[39;49;00m\n"]
[90.983, "o", "\u001b[90m  80\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mGuardar el respaldo de configuración fuera del repositorio.\u001b[90m\u001b[39;49;00m\n"]
[91.038, "o", "\u001b[90m  81\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mLas credenciales no se versionan; el documento fuente las omite a propósito.\u001b[90m\u001b[39;49;00m\n"]
